#!url=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/cuios.shop.sgmodule
#!name=cuios.shop — Gold + Camera v2.3 (thử nghiệm)
#!desc=Sửa feature_gates thật, bổ sung field camera và nhận request null. Có thông báo khi sửa JSON; chưa xác nhận camera trên iPhone.

[Script]
LocketGoldRequestV2 = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^/?#]+)\/?(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.3.0-camera/LocketGold.js, timeout=10
LocketGoldResponseV2 = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^/?#]+)\/?(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.3.0-camera/LocketGold.js, requires-body=true, max-size=1048576, timeout=10
LocketCameraRequestV23 = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(641029076083|locket-4252a)\/namespaces\/firebase:fetch(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.3.0-camera/LocketCamera.js, argument=debug=1&notify=1, engine=jsc, timeout=10
LocketCameraResponseV23 = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(641029076083|locket-4252a)\/namespaces\/firebase:fetch(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.3.0-camera/LocketCamera.js, requires-body=true, max-size=1048576, argument=debug=1&notify=1, engine=jsc, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
