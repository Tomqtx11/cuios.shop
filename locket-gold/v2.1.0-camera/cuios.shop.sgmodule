#!url=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.1.0-camera/cuios.shop.sgmodule
#!name=cuios.shop — Gold + Camera 60s + Mic (thử nghiệm)
#!desc=Đặt cờ camera 60s/mic qua Remote Config; cần quyền mic iOS. Chưa xác nhận quay hoặc upload trên máy thật.

[Script]
LocketGoldRequestV2 = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^/?#]+)\/?(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.1.0-camera/LocketGold.js, timeout=10
LocketGoldResponseV2 = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^/?#]+)\/?(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.1.0-camera/LocketGold.js, requires-body=true, max-size=1048576, timeout=10
LocketCameraRequestV21 = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(641029076083|locket-4252a)\/namespaces\/firebase:fetch(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.1.0-camera/LocketCamera.js, argument=debug=1, timeout=10
LocketCameraResponseV21 = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(641029076083|locket-4252a)\/namespaces\/firebase:fetch(\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Tomqtx11/cuios.shop/refs/heads/main/locket-gold/v2.1.0-camera/LocketCamera.js, requires-body=true, max-size=1048576, argument=debug=1, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
